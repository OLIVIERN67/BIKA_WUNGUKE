# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL / Neon)
# Get these values from the Neon dashboard (Connection Details).
PGHOST=your-neon-host.neon.tech
PGPORT=5432
PGDATABASE=bika_wunguke
PGUSER=your_database_user
PGPASSWORD=your_password_here
PGSSLMODE=require
PGCHANNELBINDING=require
# Schema used by the app (tests use a separate schema automatically)
PGSCHEMA=public

# Auth
# In production this MUST be a unique random value of at least 32 characters
# (e.g. `openssl rand -hex 32`). The server refuses to start in production
# with a placeholder or too-short secret.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Number of trusted reverse proxies in front of the API (for correct
# rate-limit client IPs). Leave empty to default to 1 in production, 0
# otherwise. Set to "true" if the proxy count is unknown.
TRUST_PROXY=

# CORS (frontend origin)
CLIENT_ORIGIN=http://localhost:5173

# Frontend origin used to build password-reset links (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Email (SMTP) - required for the email verification (OTP) and Forgot Password features
# See "Email (SMTP) setup" in README.md
# Port 465 uses implicit TLS (recommended, most reliable for Gmail); port 587
# uses STARTTLS (set SMTP_SECURE=false).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Bare from address, plus an optional friendly display name.
EMAIL_FROM=
EMAIL_FROM_NAME=BIKA WUNGUKE
# Optional Reply-To (defaults to EMAIL_FROM when unset).
EMAIL_REPLY_TO=
